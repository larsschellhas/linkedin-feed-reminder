{
  "manifest_version": 3,
  "name": "LinkedIn Feed Reminder",
  "version": "1.0.0",
  "description": "Fragt beim Öffnen des LinkedIn-Feeds, was du vorhast, und erinnert dich nach 5 Minuten daran.",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-feed-reminder@schellhasconsulting.de",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
